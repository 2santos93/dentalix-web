NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
NEXT_PUBLIC_ROOT_DOMAIN="dentalix.local"
# Origen del bucket o de la API para `img-src`/`frame-src` de los documentos del paciente y `connect-src` de la subida directa
# al bucket (DX-259, POST prefirmado por XHR); por defecto, el origen de NEXT_PUBLIC_API_URL (almacén en disco).
# Con MinIO local (STORAGE_DRIVER=s3 en la API): http://localhost:9000. El bucket necesita CORS para este origen (README de la API).
# NEXT_PUBLIC_FILES_ORIGIN="https://archivos.ejemplo.com"
