# DX-083: variables de SERVIDOR, leídas en runtime (no se incrustan al
# compilar): la misma imagen sirve en staging y en producción cambiando solo
# estas. En producción la web NO arranca sin API_URL http(s) válida (OPS-024).
# Antes eran NEXT_PUBLIC_API_URL y NEXT_PUBLIC_FILES_ORIGIN: ya no se leen. Si
# las tienes en tu .env.local, renómbralas (la web lo avisa al arrancar).
# URL de la API: el proxy `/api/v1` del host de la clínica, el SSR y la subida
# de la importación. Sin ella, fuera de producción, http://localhost:3000/api/v1.
API_URL="http://localhost:3000/api/v1"
# Origen del bucket o de la API para `img-src`/`frame-src` de los documentos del paciente y `connect-src` de la subida directa
# al bucket (DX-259, POST prefirmado por XHR); por defecto, el origen de API_URL (almacén en disco).
# Con MinIO local (STORAGE_DRIVER=s3 en la API): http://localhost:9000. El bucket necesita CORS para este origen (README de la API).
# FILES_ORIGIN="https://archivos.ejemplo.com"
# Esta SÍ se incrusta al compilar (la usa el navegador): en la imagen, build-arg
# NEXT_PUBLIC_ROOT_DOMAIN del Dockerfile.
NEXT_PUBLIC_ROOT_DOMAIN="dentalix.local"
